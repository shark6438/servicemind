+def run_probe(
+    root: Path, tests: Sequence[str], pytest_args: Sequence[str]
+) -> tuple[int, list[dict], str]:
+    with tempfile.TemporaryDirectory() as temporary:
+        evidence = Path(temporary) / "phases.json"
+        try:
+            proc = subprocess.run(
+                [
+                    sys.executable,
