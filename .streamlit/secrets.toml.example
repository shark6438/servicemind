[auth]
redirect_uri = "http://127.0.0.1:8501/oauth2callback"
cookie_secret = "replace-with-at-least-32-random-bytes"
expose_tokens = ["access"]

[auth.keycloak]
client_id = "servicemind-api"
# The bundled Keycloak client is public. Streamlit requires this key to exist;
# Authlib ignores its value because token_endpoint_auth_method is explicitly none.
client_secret = ""
server_metadata_url = "http://127.0.0.1:8090/realms/servicemind/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email", token_endpoint_auth_method = "none" }
