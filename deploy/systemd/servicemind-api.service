[Unit]
Description=ServiceMind Agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/data1/servicemind
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/data1/servicemind/.venv/bin/servicemind-api
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
