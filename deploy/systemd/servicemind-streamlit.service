[Unit]
Description=ServiceMind Streamlit UI
After=network-online.target servicemind-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/data1/servicemind
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/data1/servicemind/.venv/bin/streamlit run src/streamlit_app.py --server.address=127.0.0.1 --server.port=8501 --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
